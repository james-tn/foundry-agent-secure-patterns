# Local environment configuration for the POC demo scripts.
#
# Copy to env.local and fill in your own values:
#     cp env.local.example env.local
#
# env.local is read by preflight.sh and the demo runners. Keep it out of any
# shared copy of this repo — it is the only place deployment identifiers live.

# Azure subscription that hosts the deployment
AZ_SUBSCRIPTION=""

# Expected sign-in domain (used only as a sanity check; leave empty to skip)
EXPECTED_USER_DOMAIN=""

# Resource groups
RG_SECURE=""          # private/network-injected environment
RG_LATENCY=""         # latency probe environment

# Core resources
FOUNDRY_ACCOUNT=""    # Foundry (AIServices) account name
INTERNAL_API_APP=""   # internal-only Container App exposing the stub API

# Session pools
POOL_CONTROLLED=""    # custom container pool
POOL_BASELINE=""      # managed Python pool used as baseline
POOL_COLD=""          # latency probe pool (no warm instances)
POOL_WARM=""          # latency probe pool (warm instances requested)

# Demo jobs
JOB_PRIVATE_API=""    # in-VNet runner for the private API demo
JOB_CODE_TEST=""      # in-VNet runner for the code execution demo

# Model deployment used for PTU cost guard
OAI_RG=""
OAI_ACCOUNT=""
# Project data-plane endpoint used by the probes, e.g.
#   https://<account>.services.ai.azure.com/api/projects/<project>
OAI_PROJECT_ENDPOINT=""

# --- Infrastructure deployment only (read by *.bicepparam) ---
# Export these before running `az deployment group create`.
ACA_ENVIRONMENT_ID=""   # resource ID of the Container Apps environment
POOL_IDENTITY_ID=""     # resource ID of the pool's user-assigned identity
POOL_IMAGE=""           # container image for the controlled pool
EXISTING_AI_SEARCH_ID="" # optional: reuse an existing AI Search service
